# NewsData.io API Key (https://newsdata.io)
NEWSDATA_API_KEY=your_newsdata_api_key_here

# One-time bootstrap token for initial admin account creation
BOOTSTRAP_TOKEN=your_secure_random_bootstrap_token

# Daily credit cap for NewsData.io free or paid tier (e.g. 160 or 200)
DAILY_CREDIT_CAP=160

# Session lifetime in hours (e.g. 168 = 7 days)
SESSION_TTL_HOURS=168

# Allowed App Origin for CORS (optional in production on same origin)
APP_ORIGIN=https://mynews.yoursubdomain.workers.dev
